{
    "name": "@nuttumrunit/nuttum-bot",
    "version": "1.0.0",
    "description": "Market-paced AI city builder: one verified trade becomes one block.",
    "main": "bot.js",
    "type": "commonjs",
    "bin": {
        "nuttum-bot": "bot.js"
    },
    "files": [
        "bot.js",
        "signal-gateway.js",
        "cam-capture.js",
        "ai.config.example.json",
        ".env.example",
        "README.md"
    ],
    "scripts": {
        "start": "node bot.js",
        "gateway": "node signal-gateway.js",
        "capture": "node cam-capture.js",
        "capture:install": "npx playwright install chromium"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nuttumrunit/Nuttum.git",
        "directory": "bot"
    },
    "keywords": [
        "minecraft",
        "mineflayer",
        "ai-agent",
