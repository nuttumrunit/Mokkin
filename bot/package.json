    "author": "nuttumrunit",
    "license": "MIT",
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "dependencies": {
        "canvas": "^3.2.3",
        "dotenv": "^16.4.7",
        "minecraft-data": "^3.60.0",
        "mineflayer": "^4.20.0",
        "mineflayer-pathfinder": "^2.4.5",
        "openai": "^4.55.0",
        "playwright": "^1.51.0",
        "prismarine-schematic": "^1.2.3",
        "prismarine-viewer": "^1.28.0",
        "vec3": "^0.1.10"
    }
