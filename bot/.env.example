# Public Solana log subscriptions. Use a dedicated provider WebSocket in production.
NUTTUM_SOLANA_WS=wss://api.mainnet-beta.solana.com
NUTTUM_SIGNAL_GATEWAY=http://127.0.0.1:8891
NUTTUM_FOMO_SIGNER=AgmLJBMDCqWynYnQiPCuj9ewsNNsBJXyzoUhD9LJzN51
NUTTUM_PUMP_PROGRAM=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
NUTTUM_PUMPSWAP_PROGRAM=pAMMBay6oceH9fJKBRHGP5D4bD4sWpmSwMn52FMfXEA
