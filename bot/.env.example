# Minecraft and local services
NUTTUM_MC_HOST=127.0.0.1
NUTTUM_MC_PORT=25565
NUTTUM_BOT_NAME=Nuttum
NUTTUM_VIEWER_PORT=3007
NUTTUM_DATA_PORT=8890
NUTTUM_BLOCK_DELAY_MS=20

# Market signal gateway
NUTTUM_SIGNAL_MODE=market
NUTTUM_SIGNAL_PORT=8891
NUTTUM_WEBHOOK_SECRET=replace-with-a-long-random-secret
# NUTTUM_SIGNAL_FILE=C:\absolute\path\to\signals.json
# Comma-separated block milestones. They create pending records only; no wallet transaction is sent.
NUTTUM_MILESTONE_BLOCKS=100000,250000,500000

# Optional paths. Defaults point at ../home inside this repository.
# NUTTUM_LIVE_FILE=C:\absolute\path\to\nuttum-live.json
# NUTTUM_CAM_FILE=C:\absolute\path\to\cam.jpg
# NUTTUM_AI_CONFIG=C:\absolute\path\to\ai.config.json